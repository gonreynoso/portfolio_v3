---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';

import { LANGS, OG_LOCALE, alternatePath, useTranslations } from "../i18n";

export interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
}

const { title, description, image = '/og-image.webp', ogType = 'website' } = Astro.props;

const site = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImageURL = new URL(image, site);

const { lang } = useTranslations(Astro.url);

// Every page exists in both locales, so each one advertises the other plus an
// x-default pointing at the unprefixed Spanish route.
const alternates = LANGS.map((code) => ({
	code,
	href: new URL(alternatePath(Astro.url, code), site).href,
}));
const xDefault = new URL(alternatePath(Astro.url, "es"), site).href;

const OG_IMAGE_ALT = {
	es: "Gonzalo Reynoso · desarrollador freelance bajo la marca Kensiweb",
	en: "Gonzalo Reynoso · freelance developer under the Kensiweb brand",
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#0f0f14" />
<meta name="generator" content={Astro.generator} />

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Locale alternates -->
{alternates.map(({ code, href }) => (
	<link rel="alternate" hreflang={code} href={href} />
))}
<link rel="alternate" hreflang="x-default" href={xDefault} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<!-- This site is the person; KensiWeb is a separate agency site. Naming this
     page "Kensiweb" made search engines treat one brand as two competing
     entities. The agency is linked from the JSON-LD instead. -->
<meta property="og:site_name" content="Gonzalo Reynoso" />
<meta property="og:locale" content={OG_LOCALE[lang]} />
{LANGS.filter((code) => code !== lang).map((code) => (
	<meta property="og:locale:alternate" content={OG_LOCALE[code]} />
))}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={OG_IMAGE_ALT[lang]} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />
<meta name="twitter:image:alt" content={OG_IMAGE_ALT[lang]} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Gonzalo Reynoso",
  "url": "https://gonreynoso.com",
  "sameAs": [
    "https://linkedin.com/in/gonreynoso",
    "https://github.com/gonreynoso"
  ],
  "jobTitle": "Freelance Developer",
  "description": description,
  "worksFor": {
    "@type": "Organization",
    "name": "KensiWeb",
    "url": "https://kensiweb.com"
  }
})} />
