---
import { dict } from "../../i18n";

// Clients that have a case study of their own.
const CASE_LINKS: Record<string, string> = {
  "Refugio Ilón": "/casos/refugioilon-booking",
  "Estudio Froment & Asociados": "/estudiofroment",
  "Intima Online": "/casos/intima-online",
  "Medicina Diagnóstica - Centro Médico": "/casos/medicina-diagnostica",
  "La Carlota del Monte - Tierra de Caballos": "/casos/la-carlota",
  "Laboratorio Spotorno": "/casos/laboratorio-spotorno",
  "Legally On The Move - Asesoría Legal para Migrantes":
    "/casos/legally-on-the-move",
};

const es = dict.es.experience;
const en = dict.en.experience;

const bullet =
  "relative pl-4 text-[0.75rem] leading-[1.85] text-t2 before:absolute before:left-0 before:text-ac before:content-['·']";
const meta = "text-[0.6875rem] tracking-[0.06em] text-t3";
---

<div class="flex flex-col gap-8">
  <!-- Kensiweb -->
  <section class="fu relative border-l border-ac30 pl-7">
    <span class="absolute -left-[4px] top-1.5 block h-[0.4375rem] w-[0.4375rem] rounded-full bg-ac"
    ></span>

    <header class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="text-[0.875rem] font-semibold text-t1">
        <span data-lang="es">{es.kensiweb.role}</span>
        <span data-lang="en">{en.kensiweb.role}</span>
        <span class="text-t3"> · </span>
        <a
          href="https://kensiweb.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ac no-underline transition-opacity duration-v4 hover:opacity-80"
        >
          {es.kensiweb.company}
        </a>
      </h3>
      <span class={meta}>
        <span data-lang="es">{es.kensiweb.period} · {es.kensiweb.location}</span>
        <span data-lang="en">{en.kensiweb.period} · {en.kensiweb.location}</span>
      </span>
    </header>

    <p class="mt-2 max-w-2xl text-[0.75rem] leading-[1.85] text-t2">
      <span data-lang="es">{es.kensiweb.summary}</span>
      <span data-lang="en">{en.kensiweb.summary}</span>
    </p>

    <h4 class="mb-3 mt-6 text-[0.625rem] tracking-[0.14em] text-t3">
      <span data-lang="es">{es.kensiweb.clientsLabel}</span>
      <span data-lang="en">{en.kensiweb.clientsLabel}</span>
    </h4>

    <ul class="flex list-none flex-col gap-3.5">
      {
        es.kensiweb.clients.map((clientEs, i) => {
          const clientEn = en.kensiweb.clients[i];
          const href = CASE_LINKS[clientEs.name];

          return (
            <li class="rounded-v4 border border-b1 bg-s1 p-5">
              <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                <span class="text-[0.625rem] tracking-[0.14em] text-t3">
                  <span data-lang="es">{es.clientLabel}</span>
                  <span data-lang="en">{en.clientLabel}</span>
                </span>
                {href ? (
                  <a
                    href={href}
                    class="text-[0.8125rem] font-semibold text-t1 no-underline transition-colors duration-v4 hover:text-ac"
                  >
                    {clientEs.name}
                  </a>
                ) : (
                  <span class="text-[0.8125rem] font-semibold text-t1">
                    {clientEs.name}
                  </span>
                )}
                <span class={meta}>
                  <span data-lang="es">
                    {clientEs.period} · {clientEs.location}
                  </span>
                  <span data-lang="en">
                    {clientEn.period} · {clientEn.location}
                  </span>
                </span>
              </div>

              <div class="mt-1.5 text-[0.75rem] leading-[1.85] text-t2">
                <span class="text-t3">
                  <span data-lang="es">{es.projectLabel} </span>
                  <span data-lang="en">{en.projectLabel} </span>
                </span>
                <span data-lang="es">{clientEs.project}</span>
                <span data-lang="en">{clientEn.project}</span>
              </div>

              <ul class="mt-3 flex list-none flex-col gap-1">
                {clientEs.bullets.map((b, j) => (
                  <li class={bullet}>
                    <span data-lang="es">{b}</span>
                    <span data-lang="en">{clientEn.bullets[j]}</span>
                  </li>
                ))}
              </ul>
            </li>
          );
        })
      }
    </ul>
  </section>

  <!-- Medicina Diagnóstica -->
  <section class="fu relative border-l border-b1 pl-7">
    <span class="absolute -left-[4px] top-1.5 block h-[0.4375rem] w-[0.4375rem] rounded-full bg-b2"
    ></span>

    <header class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h3 class="text-[0.875rem] font-semibold text-t1">
        <span data-lang="es">{es.medicina.role}</span>
        <span data-lang="en">{en.medicina.role}</span>
        <span class="text-t3"> · </span>
        {es.medicina.company}
      </h3>
      <span class={meta}>
        <span data-lang="es">{es.medicina.period} · {es.medicina.location}</span>
        <span data-lang="en">{en.medicina.period} · {en.medicina.location}</span>
      </span>
    </header>

    <ul class="mt-3 flex list-none flex-col gap-1">
      {
        es.medicina.bullets.map((b, i) => (
          <li class={bullet}>
            <span data-lang="es">{b}</span>
            <span data-lang="en">{en.medicina.bullets[i]}</span>
          </li>
        ))
      }
    </ul>
  </section>
</div>
