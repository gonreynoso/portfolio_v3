---
interface Props {
  id?: string;
  /** Consecutive sections drop their top padding so the rhythm doesn't double. */
  tight?: boolean;
  class?: string;
}

const { id, tight = false, class: className = "" } = Astro.props;
---

<section
  id={id}
  class:list={[
    "mx-auto max-w-[1200px] px-6 pb-[3.75rem] md:px-12 md:pb-[6.25rem]",
    tight ? "pt-0" : "pt-[3.75rem] md:pt-[6.25rem]",
    className,
  ]}
>
  <slot />
</section>
