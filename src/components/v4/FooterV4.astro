---
import { dict } from "../../i18n";

const year = new Date().getFullYear();
---

<footer
  class="flex flex-col items-center gap-1.5 border-t border-b1 px-6 py-4 text-center text-[11px] tracking-[0.06em] text-t3 md:flex-row md:justify-between md:px-12 md:py-5 md:text-left"
>
  <span>
    // gonzalo.dev &middot;{" "}
    <span data-lang="es">{dict.es.footer.developedBy}</span>
    <span data-lang="en">{dict.en.footer.developedBy}</span>
    &copy; {year}
  </span>
  <span>
    <span data-lang="es">{dict.es.footer.brandNote}</span>
    <span data-lang="en">{dict.en.footer.brandNote}</span>{" "}
    <a
      href="https://kensiweb.com"
      target="_blank"
      rel="noopener noreferrer"
      class="text-ac no-underline transition-opacity duration-v4 hover:opacity-80"
    >
      Kensiweb
    </a>
  </span>
</footer>
