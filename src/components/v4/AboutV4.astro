---
import { Image } from "astro:assets";

import Section from "./Section.astro";
import SectionHead from "./SectionHead.astro";
import profile from "../../assets/profile.webp";
import { useTranslations } from "../../i18n";

const { t } = useTranslations(Astro.url);

// The dictionary marks emphasis with **…**. In v4 that emphasis is the accent
// highlight the design calls `.hi`.
const renderEmphasis = (text: string) =>
  text.replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold text-ac">$1</strong>');

const PARAGRAPHS = ["p1", "p2", "p3"] as const;
---

<Section id="sobre-mi" tight>
  <SectionHead number="03" eyebrow={t.eyebrows.about} title={t.about.title} />

  <div class="fu grid items-start gap-8 md:grid-cols-[1fr_300px] md:gap-16">
    <div class="order-2 md:order-1">
      {
        PARAGRAPHS.map((p) => (
          <p
            class="mb-[1.125rem] text-[0.8125rem] leading-[1.9] text-t2 last:mb-0"
            set:html={renderEmphasis(t.about[p])}
          />
        ))
      }
    </div>

    <Image
      src={profile}
      alt="Gonzalo Reynoso"
      widths={[300, 600, 900]}
      sizes="(min-width: 768px) 300px, 100vw"
      class="order-1 mx-auto aspect-square w-full max-w-[18rem] rounded-v4 border border-b1 bg-s1 object-cover object-top md:order-2 md:max-w-none md:aspect-[3/4]"
    />
  </div>
</Section>
