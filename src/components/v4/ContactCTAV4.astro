---
import { dict } from "../../i18n";

const EMAIL = "gonzalo.reynoso9@gmail.com";
---

<div id="contacto" class="mx-auto max-w-[1100px] px-6 pb-[60px] md:px-12 md:pb-[100px]">
  <div
    class="fu relative overflow-hidden rounded-v4 border border-b1 bg-s1 px-8 py-14 text-center md:px-12 md:py-[72px]"
  >
    <!-- The hero glow, restated to bookend the page. -->
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(ellipse 60% 320px at 50% -40px, var(--ac06), transparent 70%)"
    >
    </div>

    <div class="relative">
      <div class="mb-4 text-[11px] tracking-[0.18em] text-ac">
        04 /{" "}
        <span data-lang="es">CONTACTO</span>
        <span data-lang="en">CONTACT</span>
      </div>

      <h2
        class="mb-3 text-[clamp(24px,4vw,42px)] font-bold tracking-[-0.025em] text-t1"
      >
        <span data-lang="es">{dict.es.contactCta.title}</span>
        <span data-lang="en">{dict.en.contactCta.title}</span>
      </h2>

      <p class="mb-9 text-[13px] text-t2">
        <span data-lang="es">{dict.es.contactCta.body}</span>
        <span data-lang="en">{dict.en.contactCta.body}</span>
      </p>

      <a
        href={`mailto:${EMAIL}`}
        class="inline-flex items-center gap-2 rounded-v4 bg-ac px-[30px] py-[13px] text-[12px] font-bold tracking-[0.1em] text-onac no-underline transition duration-v4 hover:-translate-y-0.5 hover:opacity-[0.87] hover:shadow-[0_10px_36px_var(--ac30)]"
      >
        <span data-lang="es">{dict.es.contactCta.button}_</span>
        <span data-lang="en">{dict.en.contactCta.button}_</span>
      </a>
    </div>
  </div>
</div>
