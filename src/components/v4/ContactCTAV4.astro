---
import { useTranslations } from "../../i18n";

const EMAIL = "gonzalo.reynoso9@gmail.com";

const { t } = useTranslations(Astro.url);
---

<div id="contacto" class="mx-auto max-w-[1200px] px-6 pb-[3.75rem] md:px-12 md:pb-[6.25rem]">
  <div
    class="fu relative overflow-hidden rounded-v4 border border-b1 bg-s1 px-8 py-14 text-center md:px-12 md:py-[4.5rem]"
  >
    <!-- The hero glow, restated to bookend the page. -->
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(ellipse 60% 320px at 50% -40px, var(--ac06), transparent 70%)"
    >
    </div>

    <div class="relative">
      <div class="mb-4 text-[0.6875rem] tracking-[0.18em] text-ac">
        04 /{" "}
        {t.eyebrows.contact}
      </div>

      <h2
        class="mb-3 text-[clamp(1.5rem,4vw,2.625rem)] font-bold tracking-[-0.025em] text-t1"
      >
        {t.contactCta.title}
      </h2>

      <p class="mb-9 text-[0.8125rem] text-t2">
        {t.contactCta.body}
      </p>

      <a
        href={`mailto:${EMAIL}`}
        class="inline-flex items-center gap-2 rounded-v4 bg-ac px-[1.875rem] py-[0.8125rem] text-[0.75rem] font-bold tracking-[0.1em] text-onac no-underline transition duration-v4 hover:-translate-y-0.5 hover:opacity-[0.87] hover:shadow-[0_10px_36px_var(--ac30)]"
      >
        {t.contactCta.button}_
      </a>
    </div>
  </div>
</div>
