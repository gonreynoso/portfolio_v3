---
interface Props {
  /** Two-digit section index, e.g. "01". */
  number: string;
  eyebrowEs: string;
  eyebrowEn: string;
  titleEs: string;
  titleEn: string;
  subtitleEs?: string;
  subtitleEn?: string;
}

const {
  number,
  eyebrowEs,
  eyebrowEn,
  titleEs,
  titleEn,
  subtitleEs,
  subtitleEn,
} = Astro.props;
---

<div class="fu mb-14">
  <div class="mb-2.5 text-[11px] tracking-[0.18em] text-ac">
    {number} /{" "}
    <span data-lang="es">{eyebrowEs}</span>
    <span data-lang="en">{eyebrowEn}</span>
  </div>

  <h2
    class="text-[clamp(28px,4vw,46px)] font-bold leading-[1.1] tracking-[-0.026em] text-t1"
  >
    <span data-lang="es">{titleEs}</span>
    <span data-lang="en">{titleEn}</span>
  </h2>

  {
    subtitleEs && (
      <p class="mt-3.5 max-w-[580px] text-[13px] leading-[1.85] text-t2">
        <span data-lang="es">{subtitleEs}</span>
        <span data-lang="en">{subtitleEn}</span>
      </p>
    )
  }
</div>
