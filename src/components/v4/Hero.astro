---
import { Image } from "astro:assets";

import GitHub from "@components/icons/GitHub.astro";
import LinkedIn from "@components/icons/LinkedIn.astro";
import Mail from "@components/icons/Mail.astro";
import profile from "../../assets/profile.webp";
import { dict } from "../../i18n";

const EMAIL = "gonzalo.reynoso9@gmail.com";
const LINKEDIN = "https://linkedin.com/in/gonreynoso";
const GITHUB = "https://github.com/gonreynoso";
const KENSIWEB = "https://kensiweb.com";
const RESUME_ES = "/Resume_Gonzalo_Reynoso_ES.pdf";
const RESUME_EN = "/Resume_Gonzalo_Reynoso_EN.pdf";

const chip =
  "inline-flex items-center gap-1.5 rounded-v4 border border-b1 px-3 py-1.5 text-[0.6875rem] tracking-[0.06em] text-t2 no-underline transition-colors duration-v4 hover:border-ac hover:text-ac [&>svg]:h-3.5 [&>svg]:w-3.5";
---

<section
  id="inicio"
  class="relative flex min-h-screen flex-col items-center justify-center overflow-hidden px-10 pb-20 pt-[6.25rem] text-center"
>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[30rem]"
    style="background: radial-gradient(ellipse 80% 380px at 50% -80px, var(--ac06), transparent 70%)"
  >
  </div>

  <div
    class="relative mb-9 inline-flex items-center gap-2.5 rounded-[2px] border border-ac30 bg-ac06 px-4 py-1.5 text-[0.6875rem] tracking-[0.12em] text-ac"
  >
    freelance_developer.init()
    <span class="inline-block h-[0.8125rem] w-[0.4375rem] animate-v4-blink bg-ac align-[-2px]"
    ></span>
  </div>

  <!-- Avatar: spinning conic ring, a mask that cuts it into an arc, then the photo. -->
  <div class="relative mx-auto mb-8 h-[7.25rem] w-[7.25rem]">
    <div
      class="absolute -inset-[3px] animate-v4-spin rounded-full"
      style="background: conic-gradient(var(--ac) 0deg, transparent 110deg, var(--ac) 230deg, transparent 290deg, var(--ac) 360deg)"
    >
    </div>
    <div class="absolute inset-[2px] rounded-full bg-bg"></div>
    <div class="absolute inset-[4px] overflow-hidden rounded-full bg-s2">
      <Image
        src={profile}
        alt="Gonzalo Reynoso"
        width={232}
        height={232}
        loading="eager"
        class="h-full w-full object-cover"
      />
    </div>
  </div>

  <div class="mb-2.5 text-[0.8125rem] tracking-[0.18em] text-ac">
    <span data-lang="es">{dict.es.hero.greeting}</span>
    <span data-lang="en">{dict.en.hero.greeting}</span>
  </div>

  <h1
    class="mb-3.5 text-[clamp(2.75rem,7vw,4.875rem)] font-bold leading-[1.04] tracking-[-0.028em] text-t1"
  >
    <span data-lang="es">
      {dict.es.hero.nameLead}{" "}
      <span class="font-light text-t2">{dict.es.hero.firstName}</span><br />
      {dict.es.hero.lastName}
    </span>
    <span data-lang="en">
      {dict.en.hero.nameLead}{" "}
      <span class="font-light text-t2">{dict.en.hero.firstName}</span><br />
      {dict.en.hero.lastName}
    </span>
  </h1>

  <div class="mb-[1.375rem] text-[0.75rem] tracking-[0.14em] text-t2">
    <span data-lang="es">{dict.es.hero.roleLead}</span>
    <span data-lang="en">{dict.en.hero.roleLead}</span>
    &middot;{" "}
    <a
      href={KENSIWEB}
      target="_blank"
      rel="noopener noreferrer"
      class="text-ac no-underline transition-opacity duration-v4 hover:opacity-80"
    >
      Kensiweb
    </a>
  </div>

  <p class="mb-3 max-w-[31.25rem] text-[clamp(0.9375rem,2.2vw,1.1875rem)] font-medium text-t1">
    <span data-lang="es">{dict.es.hero.tagline}</span>
    <span data-lang="en">{dict.en.hero.tagline}</span>
  </p>

  <p class="mb-10 max-w-[32.5rem] text-[0.8125rem] leading-[1.85] text-t2">
    <span data-lang="es">{dict.es.hero.bio}</span>
    <span data-lang="en">{dict.en.hero.bio}</span>
  </p>

  <a
    href="#contacto"
    class="mb-9 inline-flex items-center gap-2 rounded-v4 bg-ac px-[1.875rem] py-[0.8125rem] text-[0.75rem] font-bold tracking-[0.1em] text-onac no-underline transition duration-v4 hover:-translate-y-0.5 hover:opacity-[0.87] hover:shadow-[0_10px_36px_var(--ac30)]"
  >
    <span data-lang="es">{dict.es.hero.ctaContact}_</span>
    <span data-lang="en">{dict.en.hero.ctaContact}_</span>
  </a>

  <div class="flex flex-wrap justify-center gap-2">
    <a href={RESUME_ES} target="_blank" rel="noopener noreferrer" class={chip} data-lang="es">
      ↓ {dict.es.hero.resumeLabel}
    </a>
    <a href={RESUME_EN} target="_blank" rel="noopener noreferrer" class={chip} data-lang="en">
      ↓ {dict.en.hero.resumeLabel}
    </a>
    <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class={chip}>
      <LinkedIn />
      LinkedIn
    </a>
    <a href={GITHUB} target="_blank" rel="noopener noreferrer" class={chip}>
      <GitHub />
      GitHub
    </a>
    <a href={`mailto:${EMAIL}`} class={chip}>
      <Mail />
      Email
    </a>
  </div>

  <a
    href="#servicios"
    class="absolute bottom-8 left-1/2 flex -translate-x-1/2 animate-v4-bob flex-col items-center gap-[0.3125rem] text-[0.625rem] tracking-[0.14em] text-t3 no-underline transition-colors duration-v4 hover:text-ac"
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d="M8 3v10M4 9l4 4 4-4"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    scroll
  </a>
</section>
