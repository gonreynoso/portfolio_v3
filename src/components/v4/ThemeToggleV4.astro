---
// Markup only. The behaviour lives in the inline theme script in V4Layout so
// it runs before first paint and survives View Transitions.
//
// With no stored choice there is no `data-theme` attribute at all and the
// stylesheet's `prefers-color-scheme` block decides — the toggle only starts
// overriding the system once the visitor actually clicks it.
---

<button
  type="button"
  data-theme-toggle
  class="flex h-[1.625rem] w-[1.625rem] items-center justify-center rounded-[3px] border border-b1 text-t3 transition-colors duration-v4 hover:border-ac hover:text-ac"
  aria-label="Toggle theme"
>
  <!-- Sun: shown while the dark theme is active, i.e. click for light. -->
  <svg
    data-theme-icon="dark"
    class="h-3.5 w-3.5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>

  <!-- Moon: shown while the light theme is active. -->
  <svg
    data-theme-icon="light"
    class="h-3.5 w-3.5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
</button>
