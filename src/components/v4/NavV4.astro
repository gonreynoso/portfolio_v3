---
import ThemeToggleV4 from "./ThemeToggleV4.astro";
import {
  LANGS,
  alternatePath,
  localizePath,
  useTranslations,
} from "../../i18n";

interface Props {
  /** Case-study pages have no in-page sections, so their links point home. */
  sectionPrefix?: string;
}

const { sectionPrefix = "" } = Astro.props;
const { lang, t } = useTranslations(Astro.url);

// On pages with no in-page sections the anchors need a page to hang off, and
// that page has to carry the locale so English stays on the English home.
const home = sectionPrefix ? localizePath("/", lang) : "";

const LINKS = [
  { href: `${home}#inicio`, label: t.nav.sections.home },
  { href: `${home}#servicios`, label: t.nav.sections.services },
  { href: `${home}#proyectos`, label: t.nav.sections.projects },
  { href: `${home}#sobre-mi`, label: t.nav.sections.about },
  { href: localizePath("/resume", lang), label: t.nav.sections.cv },
];
---

<nav
  class="fixed inset-x-0 top-0 z-[100] flex h-[3.375rem] items-center justify-between border-b border-b1 px-5 backdrop-blur-[1rem] md:px-12"
  style="background: var(--nav-bg)"
>
  <a
    href={localizePath("/", lang)}
    class="text-[0.75rem] tracking-[0.05em] text-t3 no-underline transition-colors duration-v4 hover:text-t2"
  >
    // <b class="font-medium text-ac">gonreynoso</b>.com
  </a>

  <div class="flex items-center gap-4 md:gap-7">
    <ul class="hidden list-none gap-[1.375rem] md:flex">
      {
        LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-[0.6875rem] tracking-[0.1em] text-t2 no-underline transition-colors duration-v4 hover:text-ac"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <ThemeToggleV4 />

    <!-- Real links to the same page in the other locale, not a JS switch. -->
    <div
      class="flex overflow-hidden rounded-[3px] border border-b1"
      role="group"
      aria-label={t.nav.languageLabel}
    >
      {
        LANGS.map((code, i) => (
          <>
            {i > 0 && <div class="w-px bg-b1" />}
            <a
              href={alternatePath(Astro.url, code)}
              hreflang={code}
              data-lang-choice={code}
              aria-current={code === lang ? "true" : undefined}
              class:list={[
                "px-[0.625rem] py-1 font-mono text-[0.6875rem] font-semibold uppercase tracking-[0.1em] no-underline transition-colors duration-v4",
                code === lang ? "bg-ac12 text-ac" : "text-t3 hover:text-t2",
              ]}
            >
              {code}
            </a>
          </>
        ))
      }
    </div>
  </div>
</nav>
