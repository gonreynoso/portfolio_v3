---
// Google tags are loaded by Google Tag Manager (see `Gtm.astro`). Nothing here
// may load gtag.js as well: GA4 lives inside the container, and a second direct
// loader makes every page view count twice.
---

{
  import.meta.env.PROD && (
    <script is:inline>
      import("@vercel/analytics").then(({ inject }) => inject());
    </script>
  )
}
