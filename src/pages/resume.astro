---
import V4Layout from "../layouts/V4Layout.astro";
import WorkExperienceV4 from "@components/v4/WorkExperienceV4.astro";
import { dict } from "../i18n";

const esR = dict.es.resume;
const enR = dict.en.resume;

type SkillGroup = keyof typeof esR.skillsGroups;
const skillGroups = Object.keys(esR.skillsGroups) as SkillGroup[];

const RESUME_ES = "/Resume_Gonzalo_Reynoso_ES.pdf";
const RESUME_EN = "/Resume_Gonzalo_Reynoso_EN.pdf";

const sectionHeading =
  "mb-6 text-[19px] font-bold tracking-[-0.022em] text-t1";
const card = "rounded-v4 border border-b1 bg-s1 p-5";
const meta = "text-[11px] tracking-[0.06em] text-t3";
const bullet =
  "relative pl-4 text-[12px] leading-[1.85] text-t2 before:absolute before:left-0 before:text-ac before:content-['·']";
const downloadBtn =
  "inline-flex items-center gap-2 rounded-v4 bg-ac px-[22px] py-3 text-[11px] font-bold tracking-[0.1em] no-underline transition duration-v4 hover:-translate-y-0.5 hover:opacity-[0.87] hover:shadow-[0_10px_36px_var(--ac30)]";
---

<V4Layout
  title="Gonzalo Reynoso · Resume"
  description={esR.profileBody}
  navSectionPrefix="/"
>
  <article
    class="mx-auto max-w-[1100px] px-6 pb-[60px] pt-[100px] md:px-12 md:pb-[100px] md:pt-[130px]"
  >
    <!-- Profile -->
    <header
      class="relative mb-14 overflow-hidden rounded-v4 border border-b1 bg-s1 px-6 py-12 md:px-12 md:py-14"
    >
      <div
        class="pointer-events-none absolute inset-0"
        style="background: radial-gradient(ellipse 70% 340px at 50% -40px, var(--ac06), transparent 70%)"
      >
      </div>

      <div class="relative">
        <div class="mb-4 text-[11px] tracking-[0.18em] text-ac">
          <span data-lang="es">{esR.profileTitle}</span>
          <span data-lang="en">{enR.profileTitle}</span>
        </div>

        <h1
          class="text-[clamp(28px,4vw,46px)] font-bold leading-[1.1] tracking-[-0.026em] text-t1"
        >
          Gonzalo Reynoso
        </h1>

        <p class="mt-2 text-[12px] tracking-[0.14em] text-t2">
          <span data-lang="es">{dict.es.hero.roleLead}</span>
          <span data-lang="en">{dict.en.hero.roleLead}</span>
          &middot; <span class="text-ac">Kensiweb</span>
        </p>

        <p class="mt-5 max-w-3xl text-[13px] leading-[1.9] text-t2">
          <span data-lang="es">{esR.profileBody}</span>
          <span data-lang="en">{enR.profileBody}</span>
        </p>

        <div class="mt-8">
          <a
            href={RESUME_ES}
            target="_blank"
            rel="noopener noreferrer"
            data-lang="es"
            class={downloadBtn}
            style="color: oklch(8% 0.01 240)"
          >
            ↓ {esR.downloadPdf}
          </a>
          <a
            href={RESUME_EN}
            target="_blank"
            rel="noopener noreferrer"
            data-lang="en"
            class={downloadBtn}
            style="color: oklch(8% 0.01 240)"
          >
            ↓ {enR.downloadPdf}
          </a>
        </div>
      </div>
    </header>

    <!-- 01 · Experience -->
    <section class="mb-14">
      <h2 class={sectionHeading}>
        <span class="mr-2 text-ac">01.</span>
        <span data-lang="es">{esR.experienceTitle}</span>
        <span data-lang="en">{enR.experienceTitle}</span>
      </h2>
      <WorkExperienceV4 />
    </section>

    <!-- 02 · Internships -->
    <section class="fu mb-14">
      <h2 class={sectionHeading}>
        <span class="mr-2 text-ac">02.</span>
        <span data-lang="es">{esR.internshipsTitle}</span>
        <span data-lang="en">{enR.internshipsTitle}</span>
      </h2>

      <div class="relative border-l border-b1 pl-7">
        <span
          class="absolute -left-[4px] top-1.5 block h-[7px] w-[7px] rounded-full bg-b2"></span>

        <header class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="text-[14px] font-semibold text-t1">
            {esR.internship.role}
            <span class="text-t3"> · </span>
            {esR.internship.company}
          </h3>
          <span class={meta}>
            <span data-lang="es">
              {esR.internship.period} · {esR.internship.location}
            </span>
            <span data-lang="en">
              {enR.internship.period} · {enR.internship.location}
            </span>
          </span>
        </header>

        <ul class="mt-3 flex list-none flex-col gap-1">
          {
            esR.internship.bullets.map((b, i) => (
              <li class={bullet}>
                <span data-lang="es">{b}</span>
                <span data-lang="en">{enR.internship.bullets[i]}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 03 · Education -->
    <section class="fu mb-14">
      <h2 class={sectionHeading}>
        <span class="mr-2 text-ac">03.</span>
        <span data-lang="es">{esR.educationTitle}</span>
        <span data-lang="en">{enR.educationTitle}</span>
      </h2>

      <div class="grid gap-3.5">
        {
          esR.education.map((item, i) => {
            const en = enR.education[i];

            return (
              <article class={card}>
                <header class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                  <h3 class="text-[13px] font-semibold text-t1">
                    <span data-lang="es">{item.title}</span>
                    <span data-lang="en">{en.title}</span>
                  </h3>
                  <span class="text-t3"> · </span>
                  <span class="text-[12px] text-t2">{item.where}</span>
                  <span class:list={[meta, "ml-auto"]}>
                    <span data-lang="es">
                      {item.period}
                      {item.location ? ` · ${item.location}` : ""}
                    </span>
                    <span data-lang="en">
                      {en.period}
                      {en.location ? ` · ${en.location}` : ""}
                    </span>
                  </span>
                </header>

                <ul class="mt-3 flex list-none flex-col gap-1">
                  {item.bullets.map((b, j) => (
                    <li class={bullet}>
                      <span data-lang="es">{b}</span>
                      <span data-lang="en">{en.bullets[j]}</span>
                    </li>
                  ))}
                </ul>
              </article>
            );
          })
        }
      </div>
    </section>

    <!-- 04 · Certifications -->
    <section class="fu mb-14">
      <h2 class={sectionHeading}>
        <span class="mr-2 text-ac">04.</span>
        <span data-lang="es">{esR.certificationsTitle}</span>
        <span data-lang="en">{enR.certificationsTitle}</span>
      </h2>

      <ul class="grid list-none gap-2.5 md:grid-cols-2">
        {
          esR.certifications.map((c, i) => (
            <li>
              <a
                href={c.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-full flex-col gap-1 rounded-v4 border border-b1 bg-s1 p-4 no-underline transition duration-v4 hover:-translate-y-0.5 hover:border-b2"
              >
                <span class="text-[12px] leading-[1.7] text-t2">
                  <span data-lang="es">{c.label}</span>
                  <span data-lang="en">{enR.certifications[i].label}</span>
                </span>
                <span class="text-[10px] tracking-[0.14em] text-ac">
                  {c.issuer}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 05 · Skills -->
    <section class="fu">
      <h2 class={sectionHeading}>
        <span class="mr-2 text-ac">05.</span>
        <span data-lang="es">{esR.skillsTitle}</span>
        <span data-lang="en">{enR.skillsTitle}</span>
      </h2>

      <div class="flex flex-col gap-4">
        {
          skillGroups.map((g) => (
            <div class="grid gap-2 md:grid-cols-[140px_1fr] md:gap-4">
              <span class="text-[10px] tracking-[0.14em] text-ac md:pt-1">
                <span data-lang="es">{esR.skillsGroupLabels[g]}</span>
                <span data-lang="en">{enR.skillsGroupLabels[g]}</span>
              </span>
              <ul class="flex list-none flex-wrap gap-1.5">
                {esR.skillsGroups[g].map((skill) => (
                  <li class="rounded-[2px] border border-b1 bg-s2 px-2 py-[3px] text-[10px] tracking-[0.06em] text-t3">
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </article>
</V4Layout>
