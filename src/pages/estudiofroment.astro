---
import CaseStudyLayoutV4 from "../layouts/CaseStudyLayoutV4.astro";
import { dict } from "../i18n";
import { estudioFromentImg } from "../data/projects";

const esC = dict.es.caseFroment;
const enC = dict.en.caseFroment;

const frontendBadges = ["Astro", "Tailwind CSS", "JavaScript ES6"];
const libraryBadges = ["GSAP", "Swiper.js"];
const deployBadges = ["Vercel", "NIC.ar DNS"];
---

<CaseStudyLayoutV4
  title={esC.title}
  description={esC.summary}
  image={estudioFromentImg}
  cardImage={estudioFromentImg}
  cardAlt="Estudio Froment & Asociados"
  accentColor="#c5a059"
  esContent={{ badge: esC.badge, role: esC.role, summary: esC.summary, backToHome: esC.backToHome }}
  enContent={{ badge: enC.badge, role: enC.role, summary: enC.summary, backToHome: enC.backToHome }}
  esSections={esC.sections}
  enSections={enC.sections}
  esSpecs={esC.specs}
  enSpecs={enC.specs}
  specsData={{
    envValue: esC.specs.envValue,
    frontendBadges,
    libraryBadges,
    deployBadges,
    ctaUrl: esC.specs.ctaUrl,
  }}
/>
