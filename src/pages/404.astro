---
import V4Layout from "../layouts/V4Layout.astro";
import { dict } from "../i18n";
---

<V4Layout title="404: Not Found" navSectionPrefix="/">
  <section
    class="mx-auto flex min-h-screen max-w-[1100px] flex-col items-center justify-center px-6 py-[100px] text-center md:px-12"
  >
    <div class="mb-9 text-[11px] tracking-[0.12em] text-ac">
      route_not_found()
      <span class="ml-2 inline-block h-[13px] w-[7px] animate-v4-blink bg-ac align-[-2px]"
      ></span>
    </div>

    <h1
      class="mb-4 text-[clamp(64px,12vw,140px)] font-bold leading-none tracking-[-0.04em] text-t1"
    >
      404
    </h1>

    <p class="mb-10 max-w-[420px] text-[13px] leading-[1.85] text-t2">
      <span data-lang="es">
        La página que buscás no existe o cambió de dirección.
      </span>
      <span data-lang="en">
        The page you're looking for doesn't exist or has moved.
      </span>
    </p>

    <a
      href="/"
      class="inline-flex items-center gap-2 rounded-v4 bg-ac px-[30px] py-[13px] text-[12px] font-bold tracking-[0.1em] text-onac no-underline transition duration-v4 hover:-translate-y-0.5 hover:opacity-[0.87] hover:shadow-[0_10px_36px_var(--ac30)]"
    >
      <span data-lang="es">{dict.es.nav.home}_</span>
      <span data-lang="en">{dict.en.nav.home}_</span>
    </a>
  </section>
</V4Layout>
