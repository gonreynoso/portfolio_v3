---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import V4Layout from "./V4Layout.astro";
import { localizePath, useTranslations } from "../i18n";
import { CASE_ACCENTS, type AccentKey } from "../lib/accents";

interface ContentObj {
  badge: string;
  role: string;
  summary: string;
  backToHome: string;
}

interface SectionBase {
  number: string;
  title: string;
}

interface Sections {
  challenge: SectionBase & { body: string };
  process: SectionBase & { steps: Array<{ title: string; body: string }> };
  outcome: SectionBase & { body: string };
}

interface Specs {
  title: string;
  env: string;
  frontend: string;
  libraries: string;
  deploy: string;
  cta?: string;
}

interface SpecsData {
  envValue: string;
  frontendBadges: string[];
  libraryBadges: string[];
  deployBadges: string[];
  ctaUrl?: string;
}

interface Props {
  title: string;
  description: string;
  /** Already resolved to the page's locale by the caller. */
  content: ContentObj;
  sections: Sections;
  specs: Specs;
  specsData: SpecsData;
  /** Overrides the site accent for this page's content only — the nav and
   *  footer stay on the brand cyan. */
  accentKey?: AccentKey;
  image: ImageMetadata;
  cardAlt: string;
  cardCaption?: string;
  secondaryImage?: ImageMetadata;
  secondaryAlt?: string;
  secondaryCaption?: string;
}

const {
  title,
  description,
  content,
  sections,
  specs,
  specsData,
  accentKey,
  image,
  cardAlt,
  cardCaption,
  secondaryImage,
  secondaryAlt = cardAlt,
  secondaryCaption,
} = Astro.props as Props;

const { lang, t } = useTranslations(Astro.url);

// Each case ships both of its accents; v4.css picks the one matching the
// active theme and re-derives the alpha variants from it.
const accent = accentKey ? CASE_ACCENTS[accentKey] : undefined;
const accentVars = accent
  ? `--ac-dark: ${accent.dark}; --ac-light: ${accent.light}`
  : undefined;

const tag =
  "rounded-[2px] border border-b1 bg-s2 px-2 py-[3px] text-[0.625rem] tracking-[0.06em] text-t3";
const specLabel = "mb-2 text-[0.625rem] tracking-[0.14em] text-t3";
const home = localizePath("/", lang);
---

<V4Layout
  title={title}
  description={description}
  image={image.src}
  navSectionPrefix="/"
>
  <article
    class="mx-auto max-w-[1200px] px-6 pb-[3.75rem] pt-[6.25rem] md:px-12 md:pb-[6.25rem] md:pt-[8.125rem]"
    data-case-accent={accent ? "" : undefined}
    style={accentVars}
  >
    <a
      href={home}
      class="mb-6 inline-flex items-center gap-1.5 text-[0.6875rem] tracking-[0.12em] text-ac no-underline transition-opacity duration-v4 hover:opacity-80"
    >
      {content.backToHome}
    </a>

    <!-- Hero -->
    <header
      class="relative mb-14 overflow-hidden rounded-v4 border border-b1 bg-s1 px-6 py-14 text-center md:px-12 md:py-16"
    >
      <div
        class="pointer-events-none absolute inset-0"
        style="background: radial-gradient(ellipse 70% 340px at 50% -40px, var(--ac06), transparent 70%)"
      >
      </div>

      <div class="relative">
        <div class="mb-4 text-[0.6875rem] tracking-[0.18em] text-ac">
          {content.badge}
        </div>

        <h1
          class="mx-auto max-w-3xl text-[clamp(1.75rem,4vw,2.875rem)] font-bold leading-[1.1] tracking-[-0.026em] text-t1"
        >
          {title}
        </h1>

        <p class="mx-auto mt-4 max-w-2xl text-[0.75rem] tracking-[0.06em] text-ac">
          {content.role}
        </p>

        <p class="mx-auto mt-3 max-w-2xl text-[0.8125rem] leading-[1.85] text-t2">
          {content.summary}
        </p>
      </div>
    </header>

    <div class="grid gap-10 lg:grid-cols-3 lg:gap-16">
      <div class="lg:col-span-2">
        <!-- Challenge -->
        <section class="fu mb-12 border-b border-b1 pb-12">
          <h2 class="mb-4 text-[1.1875rem] font-bold tracking-[-0.022em] text-t1">
            <span class="mr-2 text-ac">{sections.challenge.number}.</span>
            {sections.challenge.title}
          </h2>
          <p class="text-[0.8125rem] leading-[1.9] text-t2">
            {sections.challenge.body}
          </p>

          <figure class="mt-8">
            <Image
              src={image}
              alt={cardAlt}
              widths={[600, 1000]}
              sizes="(min-width: 1024px) 700px, 100vw"
              class="w-full rounded-v4 border border-b1"
            />
            <figcaption
              class="mt-2.5 text-center text-[0.625rem] tracking-[0.06em] text-t3"
            >
              {cardCaption ?? t.caseDefaults.cardCaption}
            </figcaption>
          </figure>
        </section>

        <!-- Process -->
        <section class="fu mb-12 border-b border-b1 pb-12">
          <h2 class="mb-6 text-[1.1875rem] font-bold tracking-[-0.022em] text-t1">
            <span class="mr-2 text-ac">{sections.process.number}.</span>
            {sections.process.title}
          </h2>

          <div class="flex flex-col gap-6">
            {
              sections.process.steps.map((step) => (
                <div>
                  <h3 class="mb-1.5 text-[0.875rem] font-semibold text-t1 before:font-normal before:text-ac before:content-['//_']">
                    {step.title}
                  </h3>
                  <p class="text-[0.8125rem] leading-[1.9] text-t2">
                    {step.body}
                  </p>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Outcome -->
        <section class="fu">
          <h2 class="mb-4 text-[1.1875rem] font-bold tracking-[-0.022em] text-t1">
            <span class="mr-2 text-ac">{sections.outcome.number}.</span>
            {sections.outcome.title}
          </h2>
          <p class="text-[0.8125rem] leading-[1.9] text-t2">
            {sections.outcome.body}
          </p>

          {
            secondaryImage && (
              <figure class="mt-8">
                <Image
                  src={secondaryImage}
                  alt={secondaryAlt}
                  widths={[600, 1000]}
                  sizes="(min-width: 1024px) 700px, 100vw"
                  class="w-full rounded-v4 border border-b1"
                />
                <figcaption class="mt-2.5 text-center text-[0.625rem] tracking-[0.06em] text-t3">
                  {secondaryCaption ?? t.caseDefaults.secondaryCaption}
                </figcaption>
              </figure>
            )
          }
        </section>
      </div>

      <!-- Specs -->
      <aside class="fu">
        <div
          class="rounded-v4 border border-b1 bg-s1 p-6 lg:sticky lg:top-[4.875rem]"
        >
          <h2
            class="mb-5 border-b border-b1 pb-4 text-[0.875rem] font-semibold text-t1 before:font-normal before:text-ac before:content-['//_']"
          >
            {specs.title}
          </h2>

          <div class="flex flex-col gap-5">
            <div>
              <div class={specLabel}>{specs.env}</div>
              <span class={tag}>{specsData.envValue}</span>
            </div>

            <div>
              <div class={specLabel}>{specs.frontend}</div>
              <ul class="flex list-none flex-wrap gap-1.5">
                {
                  specsData.frontendBadges.map((b, i) => (
                    <li
                      class={
                        i === 0
                          ? "rounded-[2px] border border-ac30 bg-ac06 px-2 py-[3px] text-[0.625rem] tracking-[0.06em] text-ac"
                          : tag
                      }
                    >
                      {b}
                    </li>
                  ))
                }
              </ul>
            </div>

            {
              specsData.libraryBadges.length > 0 && (
                <div>
                  <div class={specLabel}>{specs.libraries}</div>
                  <ul class="flex list-none flex-wrap gap-1.5">
                    {specsData.libraryBadges.map((b) => (
                      <li class={tag}>{b}</li>
                    ))}
                  </ul>
                </div>
              )
            }

            {
              specsData.deployBadges.length > 0 && (
                <div>
                  <div class={specLabel}>{specs.deploy}</div>
                  <ul class="flex list-none flex-wrap gap-1.5">
                    {specsData.deployBadges.map((b) => (
                      <li class={tag}>{b}</li>
                    ))}
                  </ul>
                </div>
              )
            }

            {
              specsData.ctaUrl && (
                <a
                  href={specsData.ctaUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-1 inline-flex items-center justify-center gap-2 rounded-v4 bg-ac px-4 py-3 text-[0.6875rem] font-bold tracking-[0.1em] text-onac no-underline transition duration-v4 hover:-translate-y-0.5 hover:opacity-[0.87] hover:shadow-[0_10px_36px_var(--ac30)]"
                >
                  {specs.cta}
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-3.5 w-3.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17L17 7" />
                    <polyline points="7 7 17 7 17 17" />
                  </svg>
                </a>
              )
            }
          </div>
        </div>
      </aside>
    </div>

    <!-- Back to the project list -->
    <div class="mt-16 border-t border-b1 pt-8 text-center">
      <a
        href={`${home}#proyectos`}
        class="inline-flex items-center gap-2 rounded-v4 border border-b1 px-4 py-2.5 text-[0.6875rem] tracking-[0.06em] text-t2 no-underline transition-colors duration-v4 hover:border-ac hover:text-ac"
      >
        ← {t.projects.title}
      </a>
    </div>
  </article>
</V4Layout>
