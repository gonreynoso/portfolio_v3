---
// Shell for the v4 redesign. Runs alongside BaseLayout, which still serves
// /resume and /404 in the previous design.
import BaseHead from "@components/BaseHead.astro";
import Analytics from "@components/Analytics/Analytics.astro";
import NavV4 from "@components/v4/NavV4.astro";
import FooterV4 from "@components/v4/FooterV4.astro";
import MobileNav from "@components/v4/MobileNav.astro";
import { ViewTransitions } from "astro:transitions";

import { TRANSITION_API } from "../config";
import { HTML_LANG, useTranslations } from "../i18n";
import "@fontsource-variable/jetbrains-mono";
import "../styles/v4.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  /** Pages without the home sections point their nav links back at "/". */
  navSectionPrefix?: string;
}

const { image, ogType, navSectionPrefix = "" } = Astro.props;
const { lang, t } = useTranslations(Astro.url);

const { title = t.site.title, description = t.site.description } = Astro.props;
---

<!doctype html>
<html lang={HTML_LANG[lang]} data-locale={lang} data-v4>
  <head>
    <script is:inline>
      // Marks JS as available so the scroll-reveal hidden state can be
      // applied from CSS. Without it, a no-JS visitor would see an empty
      // page and above-the-fold content would flash hidden for a frame.
      document.documentElement.classList.add("js");
    </script>
    <script is:inline>
      // Theme: applied before first paint so there is no flash.
      //
      // Only an EXPLICIT choice is written to the root. With nothing stored,
      // no attribute is set and the stylesheet's `prefers-color-scheme` block
      // follows the visitor's system — which is also why this still works
      // with JS disabled.
      (() => {
        const root = document.documentElement;

        const stored = () => {
          try {
            const v = localStorage.getItem("theme");
            return v === "light" || v === "dark" ? v : null;
          } catch (_) {
            return null;
          }
        };

        // Held in a variable on purpose: a MediaQueryList with no strong
        // reference can be garbage-collected along with its listener.
        const mql = window.matchMedia("(prefers-color-scheme: light)");
        const systemTheme = () => (mql.matches ? "light" : "dark");

        // Only an explicit choice is written; clearing it hands control back
        // to the stylesheet's prefers-color-scheme block. The toggle icon
        // follows from CSS, so there is nothing to sync here.
        const apply = (theme) => {
          if (theme) root.setAttribute("data-theme", theme);
          else root.removeAttribute("data-theme");
        };

        apply(stored());

        // Click delegation on `document`, which survives View Transitions.
        document.addEventListener("click", (e) => {
          const t = e.target instanceof Element ? e.target : null;
          if (!t || !t.closest("[data-theme-toggle]")) return;
          const next =
            (root.getAttribute("data-theme") || systemTheme()) === "dark"
              ? "light"
              : "dark";
          try { localStorage.setItem("theme", next); } catch (_) {}
          apply(next);
        });

        document.addEventListener("astro:after-swap", () => apply(stored()));
      })();
    </script>
    <script is:inline>
      // The locale lives in the URL, so nothing here decides it. This only
      // remembers a choice the visitor made and, on a bare visit to the
      // Spanish root, honours it — before first paint, so there is no flash.
      // Any other path is left alone: a shared link must resolve to the page
      // it names.
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("lang");
        } catch (_) {}

        const path = window.location.pathname;
        const current = document.documentElement.dataset.locale;

        // Read the stored preference BEFORE recording this visit, or landing
        // on "/" would overwrite it with "es" and the redirect below could
        // never fire.
        if ((path === "/" || path === "/index.html") && stored === "en") {
          window.location.replace("/en/" + window.location.hash);
          return;
        }

        try {
          if (current) localStorage.setItem("lang", current);
        } catch (_) {}

        document.addEventListener("click", (e) => {
          const t = e.target instanceof Element ? e.target : null;
          const link = t && t.closest("[data-lang-choice]");
          if (!link) return;
          try {
            localStorage.setItem("lang", link.dataset.langChoice);
          } catch (_) {}
        });
      })();
    </script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      ogType={ogType}
    />
    <Analytics />
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body>
    <NavV4 sectionPrefix={navSectionPrefix} />
    <slot />
    <FooterV4 />
    <MobileNav sectionPrefix={navSectionPrefix} />

    <script>
      // Scroll reveal. Re-runs after every View Transitions swap because the
      // observer only ever holds elements from the page it was created on.
      const reveal = () => {
        const targets = document.querySelectorAll<HTMLElement>(".fu");
        if (!targets.length) return;

        const reduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        if (reduced) {
          targets.forEach((el) => el.classList.add("show"));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("show");
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.1 },
        );

        targets.forEach((el) => observer.observe(el));
      };

      reveal();
      document.addEventListener("astro:after-swap", reveal);
    </script>
  </body>
</html>
