---
// Shell for the v4 redesign. Runs alongside BaseLayout, which still serves
// /resume and /404 in the previous design.
import BaseHead from "@components/BaseHead.astro";
import Analytics from "@components/Analytics/Analytics.astro";
import NavV4 from "@components/v4/NavV4.astro";
import FooterV4 from "@components/v4/FooterV4.astro";
import MobileNav from "@components/v4/MobileNav.astro";
import { ViewTransitions } from "astro:transitions";

import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../config";
import "@fontsource-variable/jetbrains-mono";
import "../styles/v4.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  /** Pages without the home sections point their nav links back at "/". */
  navSectionPrefix?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  ogType,
  navSectionPrefix = "",
} = Astro.props;
---

<!doctype html>
<html lang="es" data-v4 class="lang-es">
  <head>
    <script is:inline>
      // Marks JS as available so the scroll-reveal hidden state can be
      // applied from CSS. Without it, a no-JS visitor would see an empty
      // page and above-the-fold content would flash hidden for a frame.
      document.documentElement.classList.add("js");
    </script>
    <script is:inline>
      // Theme: applied before first paint so there is no flash.
      //
      // Only an EXPLICIT choice is written to the root. With nothing stored,
      // no attribute is set and the stylesheet's `prefers-color-scheme` block
      // follows the visitor's system — which is also why this still works
      // with JS disabled.
      (() => {
        const root = document.documentElement;

        const stored = () => {
          try {
            const v = localStorage.getItem("theme");
            return v === "light" || v === "dark" ? v : null;
          } catch (_) {
            return null;
          }
        };

        // Held in a variable on purpose: a MediaQueryList with no strong
        // reference can be garbage-collected along with its listener.
        const mql = window.matchMedia("(prefers-color-scheme: light)");
        const systemTheme = () => (mql.matches ? "light" : "dark");

        // Only an explicit choice is written; clearing it hands control back
        // to the stylesheet's prefers-color-scheme block. The toggle icon
        // follows from CSS, so there is nothing to sync here.
        const apply = (theme) => {
          if (theme) root.setAttribute("data-theme", theme);
          else root.removeAttribute("data-theme");
        };

        apply(stored());

        // Click delegation on `document`, which survives View Transitions.
        document.addEventListener("click", (e) => {
          const t = e.target instanceof Element ? e.target : null;
          if (!t || !t.closest("[data-theme-toggle]")) return;
          const next =
            (root.getAttribute("data-theme") || systemTheme()) === "dark"
              ? "light"
              : "dark";
          try { localStorage.setItem("theme", next); } catch (_) {}
          apply(next);
        });

        document.addEventListener("astro:after-swap", () => apply(stored()));
      })();
    </script>
    <script is:inline>
      // i18n runtime:
      //   - runs synchronously before first paint so the wrong language
      //     never flickers,
      //   - re-applies on every View Transitions swap (the new static HTML
      //     always ships with `class="lang-es"`),
      //   - click delegation on `document` so the language pill keeps
      //     working after swaps without rebinding.
      (() => {
        const apply = (forceLang) => {
          let lang = forceLang;
          if (!lang) {
            try { lang = localStorage.getItem("lang"); } catch (_) {}
          }
          if (lang !== "es" && lang !== "en") {
            lang =
              typeof navigator !== "undefined" &&
              navigator.language &&
              navigator.language.toLowerCase().startsWith("es")
                ? "es"
                : "en";
          }
          const html = document.documentElement;
          html.classList.remove("lang-es", "lang-en");
          html.classList.add("lang-" + lang);
          html.setAttribute("lang", lang);

          document.querySelectorAll("[data-lang-set]").forEach((btn) => {
            const on = btn.dataset.langSet === lang;
            btn.classList.toggle("bg-ac12", on);
            btn.classList.toggle("text-ac", on);
            btn.classList.toggle("text-t3", !on);
            btn.setAttribute("aria-pressed", String(on));
          });
        };

        apply();

        document.addEventListener("click", (e) => {
          const t = e.target instanceof Element ? e.target : null;
          const btn = t && t.closest("[data-lang-set]");
          if (!btn) return;
          const next = btn.dataset.langSet;
          try { localStorage.setItem("lang", next); } catch (_) {}
          apply(next);
        });

        document.addEventListener("astro:after-swap", () => apply());
      })();
    </script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      ogType={ogType}
    />
    <Analytics />
    {TRANSITION_API && <ViewTransitions />}
  </head>
  <body>
    <NavV4 sectionPrefix={navSectionPrefix} />
    <slot />
    <FooterV4 />
    <MobileNav sectionPrefix={navSectionPrefix} />

    <script>
      // Scroll reveal. Re-runs after every View Transitions swap because the
      // observer only ever holds elements from the page it was created on.
      const reveal = () => {
        const targets = document.querySelectorAll<HTMLElement>(".fu");
        if (!targets.length) return;

        const reduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;

        if (reduced) {
          targets.forEach((el) => el.classList.add("show"));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("show");
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.1 },
        );

        targets.forEach((el) => observer.observe(el));
      };

      reveal();
      document.addEventListener("astro:after-swap", reveal);
    </script>
  </body>
</html>
